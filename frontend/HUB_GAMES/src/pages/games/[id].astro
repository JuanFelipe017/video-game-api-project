---
import MainLayout from '../../layouts/MainLayout.astro';
import NavBar from '../../components/NavBar';
import GameCard from '../../components/GameCard';

import type { Game } from '../../types';
import { getGame, getGames } from '../../lib/api';

export async function getStaticPaths() {
  const { results } = await getGames(1, 100);
  return results.map((game) => ({
    params: { id: String(game.id) },
  }));
}


const { id } = Astro.params;
let game: Game | null = null;
let related: Game[] = [];
let error = false;

try {
  game = await getGame(Number(id));
  if (game && game.genres?.[0]) {
    const data = await getGames(1, 5, game.genres[0].name);
    related = data.results.filter((g) => g.id !== game!.id).slice(0, 4);
  }
} catch {
  error = true;
}

if (!game && !error) {
  return Astro.redirect('/');
}
---

<MainLayout title={game ? `${game.name} — HUB_GAMES` : 'Juego no encontrado'}>
  <NavBar currentPath="/games" client:load />

  <main class="pt-24 pb-20 min-h-screen">
    {error || !game ? (
      <div class="max-w-xl mx-auto px-6 py-32 text-center">
        <span class="material-symbols-outlined text-5xl text-outline mb-4 block">broken_image</span>
        <h1 class="text-2xl font-bold font-headline mb-3">Juego no encontrado</h1>
        <a href="/" class="text-primary hover:underline">← Volver al inicio</a>
      </div>
    ) : (
      <>
        <!-- Hero con imagen de fondo -->
        <div class="relative h-[70vh] min-h-[500px] overflow-hidden">
          {game.background_image && (
            <>
              <img
                src={game.background_image}
                alt={game.name}
                class="absolute inset-0 w-full h-full object-cover scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/60 to-surface/10" />
              <div class="absolute inset-0 bg-gradient-to-r from-surface/80 via-surface/20 to-transparent" />
            </>
          )}

          <!-- Info sobre la imagen -->
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-12 max-w-7xl mx-auto">
            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-on-surface-variant text-xs mb-6">
              <a href="/" class="hover:text-primary transition-colors">Inicio</a>
              <span class="material-symbols-outlined" style="font-size:14px">chevron_right</span>
              <span class="text-on-surface">{game.name}</span>
            </div>

            <!-- Géneros -->
            {game.genres?.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {game.genres.map((g) => (
                  <span class="bg-secondary-container/20 text-secondary text-xs font-bold px-3 py-1 rounded-full backdrop-blur-md uppercase tracking-wide">
                    {g.name}
                  </span>
                ))}
              </div>
            )}

            <h1 class="text-5xl lg:text-7xl font-extrabold font-headline tracking-tight text-on-surface text-glow mb-4">
              {game.name}
            </h1>

            <!-- Stats -->
            <div class="flex flex-wrap items-center gap-6 text-sm text-on-surface-variant">
              {game.rating && (
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-secondary" style="font-size:18px;font-variation-settings:'FILL' 1">star</span>
                  <span class="text-on-surface font-semibold">{game.rating.toFixed(1)}</span>
                  {game.ratings_count && <span>({game.ratings_count.toLocaleString()} reseñas)</span>}
                </div>
              )}
              {game.metacritic && (
                <div class="flex items-center gap-1.5">
                  <span class="text-on-surface font-semibold">Metacritic</span>
                  <span class={`px-2 py-0.5 rounded text-xs font-bold ${
                    game.metacritic >= 75 ? 'bg-secondary/20 text-secondary' :
                    game.metacritic >= 50 ? 'bg-primary/20 text-primary' :
                    'bg-error/20 text-error'
                  }`}>
                    {game.metacritic}
                  </span>
                </div>
              )}
              {game.released && (
                <div class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined" style="font-size:18px">calendar_today</span>
                  {new Date(game.released).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
              )}
              {game.esrb_rating && (
                <span class="border border-outline-variant/30 px-2 py-0.5 rounded text-xs">
                  {game.esrb_rating}
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Contenido -->
        <div class="max-w-7xl mx-auto px-8 mt-12 grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Descripción -->
          <div class="lg:col-span-2">
            {game.description && (
              <section class="mb-10">
                <h2 class="text-lg font-bold font-headline mb-4 text-on-surface">Acerca del juego</h2>
                <div
                  class="text-on-surface-variant leading-relaxed space-y-3 text-sm"
                  set:html={game.description}
                />
              </section>
            )}

            <!-- Plataformas -->
            {game.platforms?.length > 0 && (
              <section class="mb-10">
                <h2 class="text-lg font-bold font-headline mb-4 text-on-surface">Plataformas</h2>
                <div class="flex flex-wrap gap-2">
                  {game.platforms.map((p) => (
                    <span class="bg-surface-container-high px-4 py-2 rounded-lg text-sm text-on-surface-variant border border-outline-variant/10">
                      {p.name}
                    </span>
                  ))}
                </div>
              </section>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="space-y-4">
            <div class="bg-surface-container rounded-2xl p-6 space-y-4">
              <h3 class="text-sm font-bold text-on-surface-variant uppercase tracking-wider">Información</h3>

              {game.released && (
                <div>
                  <p class="text-xs text-outline mb-1">Lanzamiento</p>
                  <p class="text-sm text-on-surface">
                    {new Date(game.released).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                </div>
              )}

              {game.rating && (
                <div>
                  <p class="text-xs text-outline mb-1">Rating</p>
                  <p class="text-sm text-on-surface">{game.rating.toFixed(2)} / 5</p>
                </div>
              )}

              {game.metacritic && (
                <div>
                  <p class="text-xs text-outline mb-1">Metacritic</p>
                  <p class="text-sm text-on-surface">{game.metacritic} / 100</p>
                </div>
              )}

              {game.genres?.length > 0 && (
                <div>
                  <p class="text-xs text-outline mb-1">Géneros</p>
                  <p class="text-sm text-on-surface">{game.genres.map((g) => g.name).join(', ')}</p>
                </div>
              )}
            </div>

            <!-- Agregar a favoritos (client island) -->
            <GameCard game={game} client:load />
          </aside>
        </div>

        <!-- Juegos relacionados -->
        {related.length > 0 && (
          <section class="max-w-7xl mx-auto px-8 mt-16 pt-12 border-t border-outline-variant/10">
            <h2 class="text-2xl font-bold font-headline mb-8 text-on-surface">También te puede gustar</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
              {related.map((g) => (
                <GameCard game={g} client:load />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </main>
</MainLayout>
