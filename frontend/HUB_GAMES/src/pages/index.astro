---
import MainLayout from "../layouts/MainLayout.astro";
import NavBar from "../components/NavBar";
import GameSections from "../components/GameSections";

const searchParam = Astro.url.searchParams.get("search") ?? undefined;
---

<MainLayout title={searchParam ? `"${searchParam}" — HUB GAMES` : "HUB GAMES"}>
  <NavBar currentPath="/" client:load />

  <main class="pt-32 pb-20 px-6 max-w-7xl mx-auto">
    <!-- HEADER estático: se renderiza al instante -->
    {
      !searchParam && (
        <header class="mb-16">
          <span class="text-secondary font-label uppercase tracking-widest text-sm font-bold mb-3 block">
            Bienvenido
          </span>
          <h1 class="text-6xl font-extrabold font-headline tracking-tight text-on-surface text-glow leading-tight">
            Tu biblioteca
            <br />
            <span class="text-primary">personal</span>
          </h1>
          <p class="text-on-surface-variant mt-4 max-w-xl text-lg">
            Descubre, guarda y explora los mejores juegos desde un solo lugar.
          </p>
        </header>
      )
    }

    <!-- GAME SECTIONS: isla client-side → carga asíncrona sin bloquear -->
    <GameSections client:load search={searchParam} />
  </main>

  <footer
    class="py-12 px-8 text-center text-on-surface-variant/40 text-xs tracking-widest uppercase border-t border-outline-variant/10"
  >
    © {new Date().getFullYear()} HUB GAMES — All Systems Operational
  </footer>
</MainLayout>
