---
import "../styles/global.css";
import ChatBot from '../components/ChatBot';
interface Props {
	title?: string;
	description?: string;
	showChat?: boolean;
}
const { title = "HUB_GAMES", description = "Tu launcher de juegos personal", showChat = true } =
	Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,700;0,800;1,800&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<!-- Material Symbols -->
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body class="bg-surface text-on-surface font-body min-h-screen antialiased">
		<slot />
		{showChat && <ChatBot client:load />}
	</body>
</html>

<style is:global>
	.glass-panel {
		background: rgba(19, 27, 46, 0.6);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
	}

	.text-glow {
		text-shadow: 0 0 15px rgba(173, 198, 255, 0.4);
	}

	.card-hover-scale {
		transition:
			transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.card-hover-scale:hover {
		transform: scale(1.05);
		box-shadow: 0 0 40px rgba(74, 225, 118, 0.15);
	}

	.material-symbols-outlined {
		font-variation-settings:
			"FILL" 0,
			"wght" 400,
			"GRAD" 0,
			"opsz" 24;
		font-family: "Material Symbols Outlined";
		font-size: 24px;
		line-height: 1;
		display: inline-block;
		user-select: none;
	}

	/* Scrollbar personalizada */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: #060e20;
	}
	::-webkit-scrollbar-thumb {
		background: #2d3449;
		border-radius: 3px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #424754;
	}
</style>
